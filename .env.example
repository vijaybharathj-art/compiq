# Copy to .env.local and fill in real values. Never commit real secrets.
# Tattava runs fully in Demo Mode with none of these set — see CLAUDE.md.

# --- Database (planned live-data integration) ---
DATABASE_URL="postgresql://user:password@localhost:5432/tattava?schema=public"

# --- Auth.js ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# --- AI provider (planned integration) ---
AI_PROVIDER="anthropic" # or "openai"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Demo mode ---
NEXT_PUBLIC_DEMO_MODE="true"
