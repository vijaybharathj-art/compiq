# Copy to .env and fill in real values. Never commit .env — it's gitignored.
#
# DATABASE_URL is required — Postgres is the live runtime (see CLAUDE.md,
# "Phase 1: Postgres is the live runtime"). Everything else below is a
# planned integration (Gmail/Microsoft OAuth, a real LLM provider) and can
# stay blank: the app runs fully with just DATABASE_URL + AUTH_SECRET,
# using DemoEmailProvider/DemoAIProvider (see PHASE3_EMAIL_INTELLIGENCE.md).

# --- Database (required) ---
# Standard connection string, used for both migrations and the running app.
# This Prisma 7 config (prisma.config.ts) only reads DATABASE_URL — if your
# Postgres provider requires a separate non-pooled connection for
# migrations (common on Vercel with a pooled Postgres host), point
# DATABASE_URL itself at that direct connection for `prisma migrate` runs.
DATABASE_URL="postgresql://user:password@localhost:5432/tattava?schema=public"

# --- Auth.js (required: AUTH_SECRET) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# The deployment's own public URL — required by Auth.js in production
# (e.g. https://tattava.vercel.app). Leave unset for local dev.
AUTH_URL=""
# Dual-purpose as of Phase 5 (PHASE5_REAL_EMAIL_INTEGRATION.md): the same
# Google/Microsoft OAuth app used for NextAuth sign-in (src/lib/auth/
# config.ts) is reused for the Settings -> Email mailbox-connect flow
# (src/lib/email/gmail-provider.ts, microsoft-graph-provider.ts) — a
# different scope is requested at the mailbox-connect authorization URL
# (Gmail: gmail.readonly; Microsoft: offline_access Mail.Read), never the
# sign-in scope. If you'd rather keep sign-in and mailbox-connect on
# separate OAuth app registrations, point the mailbox-connect flow's app at
# these same env vars anyway (there's a single set today, not two) and
# ensure BOTH redirect URIs are registered on it: the NextAuth callback AND
# /api/email/oauth/{gmail,microsoft}/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# --- Email provider (live as of Phase 5 for real per-account sync) ---
# Governs ONLY the org-wide Demo Mode "Run Scan" (src/lib/pipeline/
# orchestrator.ts's runScan()) — "demo" (default) reads the seeded mailbox;
# "live" is rejected outright, since Run Scan has no single account to
# target. A real connected mailbox (Settings -> Email) is untouched by this
# flag: it always syncs through the real GmailProvider/MicrosoftGraphProvider
# via getEmailProviderFor(), dispatched per EmailAccount.provider.
EMAIL_PROVIDER="demo"

# --- AI provider (planned integration) ---
# "demo" (default) — DemoAIProvider, no API key required. "anthropic" /
# "openai" require the matching key below and remain stubbed (planned
# integration — throws "PLANNED INTEGRATION" for extraction and briefing
# narration alike).
AI_PROVIDER="demo"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Confidence policy (optional — see PHASE3_EMAIL_INTELLIGENCE.md §6) ---
AI_AUTO_APPLY_THRESHOLD="90"
AI_REVIEW_THRESHOLD="70"

# --- Deal intelligence thresholds (optional — see PHASE4_DEAL_INTELLIGENCE.md §4/§6) ---
INACTIVITY_WATCH_DAYS="4"
INACTIVITY_INACTIVE_DAYS="7"
INACTIVITY_STALE_DAYS="14"
VALUATION_ALERT_MEDIUM_PCT="5"
VALUATION_ALERT_HIGH_PCT="10"
VALUATION_ALERT_CRITICAL_PCT="20"

# --- Email OAuth token encryption (required for real Gmail/Microsoft mailbox connections) ---
# AES-256-GCM key protecting stored access/refresh tokens and the OAuth
# state cookie at rest (src/lib/email/token-crypto.ts). Must decode to
# exactly 32 bytes. Generate with: openssl rand -base64 32
# Not required for Demo Mode. Required the moment any banker clicks
# Connect under Settings -> Email — without it, encryptToken()/
# decryptToken() throw rather than silently store an unencrypted token.
# Rotating this key invalidates every already-connected mailbox's stored
# tokens (they'll show "Needs reauthorization" — reconnecting re-encrypts
# under the new key). Never commit a real value; generate a fresh one per
# environment.
EMAIL_TOKEN_ENCRYPTION_KEY=""

# --- Automatic incremental sync (Phase 5B — see PHASE5B_PRODUCTION_EMAIL_OPERATIONS.md) ---
# CRON_SECRET authenticates Vercel Cron's calls to /api/cron/email-sync
# (vercel.json). Vercel automatically sends this exact value as
# `Authorization: Bearer <CRON_SECRET>` on requests it originates for a
# configured cron job — set the SAME value here and on Vercel, generate
# with: openssl rand -base64 32. Without it, the cron route refuses to run
# rather than allow an unauthenticated caller to trigger mailbox syncs.
CRON_SECRET=""
# How long since an account's last sync before the scheduler considers it
# due again (minutes). Independent of vercel.json's own cron schedule —
# the cron can fire more often than this without causing redundant syncs;
# this is the real cadence control. Default 15.
EMAIL_SYNC_INTERVAL_MINUTES="15"

# --- Demo mode ---
# Never exposed to the client beyond this literal flag — no secrets behind
# NEXT_PUBLIC_* (see SECURITY.md §3).
NEXT_PUBLIC_DEMO_MODE="true"
